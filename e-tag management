<script>
const KEY='factory_problem_tracker_v1';
let state=JSON.parse(localStorage.getItem(KEY)||'{"records":[],"reports":[]}');
// Sinkronisasi data lama: M-Tag yang sudah tersimpan sebelumnya juga dianggap selesai.
(state.reports||[]).forEach(rep=>{
  const rec=state.records.find(r=>r.id===rep.recordId);
  if(rec){
    rec.resolved=true;
    rec.resolvedAt=rep.tanggal||rec.resolvedAt||new Date().toISOString().slice(0,10);
    rec.resolvedBy=rep.pic||rec.resolvedBy||'';
    rec.status='Resolved';
    rec.mTagId=rep.id;
    // Request/Tindakan di Data Temuan mengikuti Countermeasure M-Tag.
    if(rep.countermeasure) rec.request=rep.countermeasure;
  }
});
const $=s=>document.querySelector(s);
const today=new Date().toISOString().slice(0,10);


function cleanupMonthlyData(){
  const now=new Date();
  const currentMonth=now.getFullYear()+"-"+String(now.getMonth()+1).padStart(2,"0");
  const previousMonth=localStorage.getItem(KEY+"_month");
  if(previousMonth && previousMonth!==currentMonth){
    state={records:[],reports:[]};
    localStorage.setItem(KEY,JSON.stringify(state));
  }
  localStorage.setItem(KEY+"_month",currentMonth);
}
cleanupMonthlyData();
function save(){
  localStorage.setItem(KEY,JSON.stringify(state));
  render();
  if(window.__etagCloudSave) window.__etagCloudSave(state);
}
window.__etagCloudApply=function(remoteState){
  if(!remoteState || !Array.isArray(remoteState.records) || !Array.isArray(remoteState.reports)) return;
  state=remoteState;
  localStorage.setItem(KEY,JSON.stringify(state));
  render();
};
window.__etagCloudDeleteRecord=function(id){ if(window.__etagCloudDelete) window.__etagCloudDelete('records',id); };
window.__etagCloudClear=function(){ if(window.__etagCloudClearAll) window.__etagCloudClearAll(); };
function toast(msg){const t=$('#toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2200)}
function showPage(id){if(id!=='records' && id!=='dashboard' && id!=='red' && id!=='white')window.activeMapping='';document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));$('#'+id).classList.add('active');document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('active',x.dataset.page===id));render()}
document.querySelectorAll('.nav button').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.page)));
function filterMapping(area){
  $('#search').value='';
  $('#typeFilter').value='';
  $('#priorityFilter').value='';
  setMapFilter(area);
  showPage('records');
}
function openForm(type){showPage(type); if(type==='red'||type==='white'){const f=$('#'+type+'Form');f.reset();f.tanggal.value=today;f.lokasi.value=''}}
document.querySelectorAll('input[type=date]').forEach(x=>{if(!x.value)x.value=today});

function formObj(form){return Object.fromEntries(new FormData(form).entries())}
function compressImage(file,maxSize=720,quality=.62){
  return new Promise((resolve,reject)=>{
    if(!file){resolve('');return;}
    const reader=new FileReader();
    reader.onload=()=>{
      const img=new Image();
      img.onload=()=>{
        const scale=Math.min(1,maxSize/Math.max(img.width,img.height));
        const canvas=document.createElement('canvas');
        canvas.width=Math.max(1,Math.round(img.width*scale));
        canvas.height=Math.max(1,Math.round(img.height*scale));
        const ctx=canvas.getContext('2d');
        ctx.drawImage(img,0,0,canvas.width,canvas.height);
        resolve(canvas.toDataURL('image/jpeg',quality));
      };
      img.onerror=reject;
      img.src=reader.result;
    };
    reader.onerror=reject;
    reader.readAsDataURL(file);
  });
}
function bindPhotoPreview(formId,previewId){
  const input=document.querySelector(`#${formId} input[name="foto"]`);
  const preview=document.getElementById(previewId);
  if(!input||!preview)return;
  input.addEventListener('change',async()=>{
    const file=input.files?.[0];
    if(!file){preview.src='';preview.classList.remove('show');return;}
    try{
      preview.src=await compressImage(file);
      preview.classList.add('show');
    }catch(err){preview.src='';preview.classList.remove('show');toast('Foto tidak dapat dibaca');}
  });
}
bindPhotoPreview('redForm','redPhotoPreview');
bindPhotoPreview('whiteForm','whitePhotoPreview');

$('#redForm').addEventListener('submit',async e=>{
  e.preventDefault();
  const v=formObj(e.target);
  const foto=await compressImage(e.target.foto?.files?.[0]);
  delete v.foto;
  state.records.unshift({id:crypto.randomUUID(),type:'Red Tag',...v,foto,status:'Open'});
  save();e.target.reset();$('#redPhotoPreview')?.classList.remove('show');
  toast('Red Tag berhasil disimpan');showPage('records');
});
$('#whiteForm').addEventListener('submit',async e=>{
  e.preventDefault();
  const v=formObj(e.target);
  const foto=await compressImage(e.target.foto?.files?.[0]);
  delete v.foto;
  state.records.unshift({id:crypto.randomUUID(),type:'White Tag',...v,foto});
  save();e.target.reset();$('#whitePhotoPreview')?.classList.remove('show');
  toast('White Tag berhasil disimpan');showPage('records');
});
$('#reportForm').addEventListener('submit',e=>{
  e.preventDefault();
  const v=formObj(e.target);
  const record=state.records.find(r=>r.id===v.recordId);
  if(!record){toast('Pilih data Red Tag / White Tag terlebih dahulu');return;}

  const reportId=crypto.randomUUID();
  state.reports.unshift({id:reportId,...v,sourceType:record.type,sourceName:record.nama,sourceLocation:record.lokasi});

  // Hubungkan M-Tag dengan temuan asal dan tandai sebagai sudah tertanggulangi.
  record.resolved=true;
  record.resolvedAt=v.tanggal||today;
  record.resolvedBy=v.pic||'';
  record.status='Resolved';
  record.mTagId=reportId;
  // Setelah M-Tag disimpan, Request/Tindakan menjadi isi Countermeasure.
  record.request=v.countermeasure||'';

  save();
  e.target.reset();
  e.target.tanggal.value=today;
  toast('M-Tag berhasil disimpan — problem sudah tertanggulangi');
  showPage('report');
});

function render(){
  $('#statTotal').textContent=state.records.length;
  $('#statRed').textContent=state.records.filter(x=>x.type==='Red Tag').length;
  $('#statWhite').textContent=state.records.filter(x=>x.type==='White Tag').length;
  $('#statReport').textContent=state.reports.length;
  const q=($('#search')?.value||'').toLowerCase(), tf=$('#typeFilter')?.value||'', pf=$('#priorityFilter')?.value||'';
  const mapping=window.activeMapping||'';
  const rows=state.records.filter(r=>(!mapping||r.lokasi===mapping)&&(!tf||r.type===tf)&&(!pf||r.prioritas===pf)&&JSON.stringify(r).toLowerCase().includes(q));
  $('#recordsBody').innerHTML=rows.length?rows.map(r=>`<tr><td><span class="badge ${r.type==='Red Tag'?'red':'white'}">${r.type}</span></td><td><strong>${esc(r.nama)}</strong></td><td>${esc(r.tanggal)}</td><td>${esc(r.lokasi)}</td><td>${esc(r.penemu)}</td><td><span class="badge ${r.resolved?'green':(r.type==='Red Tag'?'amber':'green')}">${esc(r.resolved?'Resolved':(r.status||r.prioritas||'—'))}</span></td><td>${r.foto?`<img src="${r.foto}" alt="Foto" style="width:46px;height:38px;object-fit:cover;border-radius:7px;border:1px solid #e2e8f0">`:''}</td><td>${esc(r.request)}</td><td><button class="btn small danger" onclick="removeRecord('${r.id}')">Hapus</button></td></tr>`).join(''):`<tr><td colspan="8" class="empty">Belum ada data temuan.</td></tr>`;
  $('#reportRecord').innerHTML='<option value="">— Pilih temuan —</option>'+state.records.map(r=>`<option value="${r.id}" ${r.resolved?'disabled':''}>${r.type} — ${esc(r.nama)}${r.resolved?' ✓ Sudah M-Tag':''}</option>`).join('');
  renderPreview();
  renderMapProblemIndicators();
}
function renderPreview(){
  const id=$('#reportRecord')?.value, r=state.records.find(x=>x.id===id), f=$('#reportForm'); if(!$('#reportPreview'))return;
  const pic=f?.pic?.value||'—', cm=f?.countermeasure?.value||'—', dt=f?.tanggal?.value||'—';
  $('#reportPreview').innerHTML=`<div class="report-head"><div><div class="kicker">M-TAG</div><h2>Countermeasure Report</h2></div><span class="badge green">DIGITAL</span></div>
  <div class="report-row"><b>Problem</b><span>${r?esc(r.nama):'Pilih temuan untuk melihat detail.'}</span></div>
  <div class="report-row"><b>Lokasi</b><span>${r?esc(r.lokasi):'—'}</span></div>
  ${r&&r.foto?`<div class="report-photo"><b>Visual Problem</b><img src="${r.foto}" alt="Foto problem"><div class="photo-caption">${esc(r.type||'Tag')} — Foto saat temuan dibuat</div></div>`:''}
  <div class="report-row"><b>PIC</b><span>${esc(pic)}</span></div>
  <div class="report-row"><b>Countermeasure</b><span>${esc(cm)}</span></div>
  <div class="report-row"><b>Tanggal</b><span>${esc(dt)}</span></div>`;
}
$('#reportRecord').addEventListener('change',renderPreview); $('#reportForm').addEventListener('input',renderPreview);
['search','typeFilter','priorityFilter'].forEach(id=>$('#'+id).addEventListener('input',render));
function removeRecord(id){if(confirm('Hapus data temuan ini?')){state.records=state.records.filter(r=>r.id!==id);save();if(window.__etagCloudDelete)window.__etagCloudDelete('records',id);toast('Data dihapus')}}
$('#clearBtn').addEventListener('click',()=>{if(confirm('Hapus SEMUA data temuan dan laporan dari browser ini dan cloud bersama?')){state={records:[],reports:[]};save();if(window.__etagCloudClearAll)window.__etagCloudClearAll();toast('Semua data dihapus')}});

function excelEscape(v){
  return String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&apos;');
}
function downloadExcel(){
  const rows=state.records.map(r=>({
    'Tipe Tag':r.type||'',
    'Nama Temuan':r.nama||'',
    'Tanggal':r.tanggal||'',
    'Lokasi / POST':r.lokasi||'',
    'Penemu':r.penemu||'',
    'Status':r.resolved?'Resolved':(r.status||r.prioritas||''),
    'Prioritas':r.prioritas||'',
    'Request / Tindakan':r.request||'',
    'Foto Problem':r.foto?'Ada':'Tidak',
    'M-Tag ID':r.mTagId||'',
    'Tanggal Resolved':r.resolvedAt||'',
    'Resolved By':r.resolvedBy||''
  }));
  const headers=Object.keys(rows[0]||{
    'Tipe Tag':'','Nama Temuan':'','Tanggal':'','Lokasi / POST':'','Penemu':'','Status':'','Prioritas':'','Request / Tindakan':'','Foto Problem':'','M-Tag ID':'','Tanggal Resolved':'','Resolved By':''
  });
  const xmlRows=[];
  // Judul laporan dibuat terpisah dari header, dengan garis bawah tegas sebagai pembatas.
  xmlRows.push('<Row ss:Height="28"><Cell ss:MergeAcross="'+(headers.length-1)+'" ss:StyleID="Title"><Data ss:Type="String">E-TAG MANAGEMENT — DATA TEMUAN</Data></Cell></Row>');
  xmlRows.push('<Row ss:Height="8"><Cell ss:MergeAcross="'+(headers.length-1)+'" ss:StyleID="Separator"><Data ss:Type="String"></Data></Cell></Row>');
  xmlRows.push('<Row>'+headers.map(h=>'<Cell ss:StyleID="Header"><Data ss:Type="String">'+excelEscape(h)+'</Data></Cell>').join('')+'</Row>');
  rows.forEach(r=>xmlRows.push('<Row>'+headers.map(h=>'<Cell ss:StyleID="Body"><Data ss:Type="String">'+excelEscape(r[h])+'</Data></Cell>').join('')+'</Row>'));
  const xml='<?xml version="1.0"?>'+
    '<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">'+
    '<Styles>'+
    '<Style ss:ID="Title"><Font ss:Bold="1" ss:Size="14"/><Alignment ss:Horizontal="Center" ss:Vertical="Center"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="3"/></Borders></Style>'+
    '<Style ss:ID="Separator"><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="2"/></Borders></Style>'+
    '<Style ss:ID="Header"><Font ss:Bold="1"/><Alignment ss:Vertical="Center"/><Borders><Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1"/></Borders></Style>'+
    '<Style ss:ID="Body"><Borders><Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1"/></Borders></Style>'+
    '</Styles>'+
    '<Worksheet ss:Name="Data Temuan"><Table>'+xmlRows.join('')+'</Table></Worksheet></Workbook>';
  const blob=new Blob([xml],{type:'application/vnd.ms-excel'});
  const a=document.createElement('a');
  const d=new Date();
  const stamp=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
  a.href=URL.createObjectURL(blob);
  a.download='Data-Temuan-'+stamp+'.xls';
  a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href),1000);
  toast('Data Temuan berhasil didownload sebagai Excel');
}
$('#exportBtn').addEventListener('click',downloadExcel);
function esc(v){return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}


function renderMapProblemIndicators(){
  const counts={};
  state.records.forEach(r=>{
    // Hanya temuan yang BELUM memiliki M-Tag yang tetap menjadi indikator merah.
    const loc=String(r.lokasi||'').trim();
    if(loc && !r.resolved) counts[loc]=(counts[loc]||0)+1;
  });

  document.querySelectorAll('.post-zone,.map-zone').forEach(z=>{
    const key=z.dataset.map||'';
    const count=counts[key]||0;
    z.classList.toggle('has-problem',count>0);
    const badge=z.querySelector('.problem-count');
    if(badge) badge.textContent=count;
    if(count>0) z.title=key+' — '+count+' problem';
  });

  const summary=document.querySelector('#mapProblemSummary');
  if(summary){
    const active=Object.entries(counts).filter(([k,v])=>v>0);
    summary.innerHTML=active.length
      ? '<span style="font-size:11px;font-weight:800;color:#475569">Problem aktif:</span>'+
        active.map(([post,count])=>'<button class="mini" data-post="'+esc(post)+'" onclick="setMapFilter(this.dataset.post);showPage(\'records\')">🔴 '+esc(post)+' · '+count+'</button>').join('')
      : '<span style="font-size:11px;color:#64748b">✓ Belum ada problem pada POST mapping.</span>';
  }
}

let activeMap = '';
function setMapFilter(area){
  activeMap = area || '';
  window.activeMapping = activeMap;
  document.querySelectorAll('.map-zone,.post-zone').forEach(z=>z.classList.toggle('selected', !!activeMap && z.dataset.map===activeMap));
  document.querySelectorAll('.map-filter').forEach(b=>b.classList.toggle('active', (b.dataset.mapFilter||'')===activeMap));
  const label = document.querySelector('#mappingSelected');
  if(label) label.textContent = activeMap || 'Semua Area';
  render();
}
document.querySelectorAll('.map-zone,.post-zone').forEach(z=>z.addEventListener('click',()=>{
  setMapFilter(z.dataset.map);
  showPage('records');
  toast('Filter mapping: '+z.dataset.map);
}));
document.querySelectorAll('.map-filter').forEach(b=>b.addEventListener('click',()=>{
  setMapFilter(b.dataset.mapFilter);
  if(b.dataset.mapFilter) showPage('records'); else showPage('dashboard');
}));



function inputFromMapPost(){
  const post=document.querySelector('#mapPostInput')?.value;
  if(!post){toast('Pilih POST terlebih dahulu');return;}
  setPostAndOpenForm(post,'red');
}

function setPostAndOpenForm(post, type){
  showPage(type);
  const f = document.querySelector('#'+type+'Form');
  if(f && f.lokasi){ f.lokasi.value=post; }
  if(f && f.tanggal){ f.tanggal.value=today; }
  toast(post+' dipilih sebagai Temuan di');
}

renderMapProblemIndicators();
render();
</script>

