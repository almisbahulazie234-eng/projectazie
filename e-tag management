    let unsubRecords=null,unsubReports=null, syncing=false;

    async function login(){
      cloudStatus('☁ Menghubungkan ke database...');
      await signInAnonymously(auth);
    }
    async function loadSharedState(){
      const month=currentMonth();
      const [rs,ps]=await Promise.all([
        getDocs(query(collection(db,'etag_records'),where('month','==',month))),
        getDocs(query(collection(db,'etag_reports'),where('month','==',month)))
      ]);
      const remoteRecords=rs.docs.map(d=>({id:d.id,...d.data()}));
      const remoteReports=ps.docs.map(d=>({id:d.id,...d.data()}));
      const local=JSON.parse(localStorage.getItem('factory_problem_tracker_v1')||'{"records":[],"reports":[]}');
      // Migrasi data lokal: bila cloud masih kosong, upload data yang sudah ada di perangkat ini.
      if(remoteRecords.length===0 && remoteReports.length===0 && (local.records.length||local.reports.length)){
        await Promise.all(local.records.map(r=>setDoc(doc(db,'etag_records',r.id),{...r,month},{merge:true})));
        await Promise.all(local.reports.map(r=>setDoc(doc(db,'etag_reports',r.id),{...r,month},{merge:true})));
        window.__etagCloudApply(local);
      }else{
        window.__etagCloudApply({records:remoteRecords,reports:remoteReports});
      }
      localStorage.setItem('factory_problem_tracker_v1_month',month);
    }
    function startRealtime(){
      const month=currentMonth();
      if(unsubRecords)unsubRecords(); if(unsubReports)unsubReports();
      unsubRecords=onSnapshot(query(collection(db,'etag_records'),where('month','==',month)),snap=>{
        const remoteRecords=snap.docs.map(d=>({id:d.id,...d.data()}));
        const current=JSON.parse(localStorage.getItem('factory_problem_tracker_v1')||'{"records":[],"reports":[]}');
        current.records=remoteRecords;
        window.__etagCloudApply(current);
        cloudStatus('☁ Tersinkronisasi • '+new Date().toLocaleTimeString());
        setTimeout(()=>cloudStatus('',false),2500);
      });
      unsubReports=onSnapshot(query(collection(db,'etag_reports'),where('month','==',month)),snap=>{
        const remoteReports=snap.docs.map(d=>({id:d.id,...d.data()}));
        const current=JSON.parse(localStorage.getItem('factory_problem_tracker_v1')||'{"records":[],"reports":[]}');
        current.reports=remoteReports;
        // Re-apply M-Tag relationship so Resolved and Countermeasure stay synchronized.
        current.records.forEach(rec=>{
          const rep=current.reports.find(x=>x.recordId===rec.id);
          if(rep){rec.resolved=true;rec.resolvedAt=rep.tanggal||rec.resolvedAt||'';rec.resolvedBy=rep.pic||rec.resolvedBy||'';rec.status='Resolved';rec.mTagId=rep.id;if(rep.countermeasure)rec.request=rep.countermeasure;}
        });
        window.__etagCloudApply(current);
      });
    }
    window.__etagCloudSave=async function(st){
      if(syncing)return; syncing=true;
      try{
        const month=currentMonth();
        await Promise.all(st.records.map(r=>setDoc(doc(db,'etag_records',r.id),{...r,month},{merge:true})));
        await Promise.all(st.reports.map(r=>setDoc(doc(db,'etag_reports',r.id),{...r,month},{merge:true})));
      }catch(e){console.error(e);cloudStatus('⚠ Gagal sinkronisasi cloud');}
      finally{syncing=false;}
    };
    window.__etagCloudDelete=async function(type,id){try{await deleteDoc(doc(db,type==='records'?'etag_records':'etag_reports',id));}catch(e){console.error(e);}};
    window.__etagCloudClearAll=async function(){try{
      const month=currentMonth();
      for(const col of ['etag_records','etag_reports']){
        const snap=await getDocs(query(collection(db,col),where('month','==',month)));
        await Promise.all(snap.docs.map(d=>deleteDoc(d.ref)));
      }
    }catch(e){console.error(e);}};
    onAuthStateChanged(auth,async user=>{
      if(!user)return;
      try{await loadSharedState();startRealtime();cloudStatus('☁ Online • data bersama aktif');setTimeout(()=>cloudStatus('',false),3500);}catch(e){console.error(e);cloudStatus('⚠ Database belum siap / Security Rules belum benar');}
    });
    login().catch(e=>{console.error(e);cloudStatus('⚠ Login cloud gagal');});
  }catch(e){console.error(e);cloudStatus('⚠ Konfigurasi Firebase tidak valid');}
}
</script>
